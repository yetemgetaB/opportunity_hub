# ============================================================================
# CAMPUS OPPORTUNITY HUB — ENVIRONMENT VARIABLES SPECIFICATION
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL & Prisma)
# ----------------------------------------------------------------------------
# Connection pooling URL (used by Prisma Client runtime queries via Supabase Supavisor / PgBouncer on port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Direct connection URL (used for migrations and direct administrative connections on port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------------------------
# Supabase Project Credentials
# ----------------------------------------------------------------------------
# Base API URL for Supabase Project
SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Public Anonymous API Key (Safe for client-side API requests)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Secret Service Role Key (RESTRICTED TO BACKEND SERVER ONLY — NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
